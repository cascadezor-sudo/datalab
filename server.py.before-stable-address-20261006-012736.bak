# -*- coding: utf-8 -*-
"""
Schmidt ML — Локальный многопоточный сервер базы знаний
Автоматически находит свободный порт, запускает сервер и открывает сайт в браузере.
"""

import os
import sys
import socket
import webbrowser
import threading
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

class CustomHTTPHandler(SimpleHTTPRequestHandler):
    def end_headers(self):
        # Отключаем агрессивный кэш браузера для локальной работы
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Cache-Control', 'no-cache, must-revalidate')
        super().end_headers()

    def log_message(self, format, *args):
        # Логируем только критические ошибки 4xx/5xx в консоль
        if len(args) > 1 and str(args[1]).startswith(('4', '5')):
            super().log_message(format, *args)

def find_free_port(start_port=8080, max_attempts=50):
    for port in range(start_port, start_port + max_attempts):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(('', port))
                return port
            except OSError:
                continue
    return start_port

def main():
    base_dir = os.path.dirname(os.path.abspath(__file__))
    site_dir = os.path.join(base_dir, "site")
    if os.path.isdir(site_dir):
        serve_dir = site_dir
    else:
        serve_dir = base_dir

    port = find_free_port(8080)
    
    class HandlerWithDir(CustomHTTPHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=serve_dir, **kwargs)

    try:
        httpd = ThreadingHTTPServer(('', port), HandlerWithDir)
    except Exception as e:
        print(f"[!] Ошибка запуска сервера на порту {port}: {e}", flush=True)
        sys.exit(1)

    if hasattr(sys.stdout, 'reconfigure'):
        try:
            sys.stdout.reconfigure(encoding='utf-8', errors='replace')
        except Exception:
            pass

    url = f"http://localhost:{port}/main.html"

    print("=" * 64, flush=True)
    print("         DATALAB -- ЛОКАЛЬНАЯ АВТОНОМНАЯ БАЗА ЗНАНИЙ", flush=True)
    print("=" * 64, flush=True)
    print(f" [OK] Сервер запущен : {url}", flush=True)
    print(f" [OK] Папка контента : {serve_dir}", flush=True)
    print(" [OK] Открываем сайт в браузере...", flush=True)
    print("=" * 64, flush=True)
    print(" Для остановки закройте это окно или нажмите Ctrl + C.", flush=True)
    print("=" * 64, flush=True)

    def open_browser():
        webbrowser.open(url)

    threading.Timer(0.6, open_browser).start()

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[!] Сервер успешно остановлен.", flush=True)
        sys.exit(0)

if __name__ == '__main__':
    main()
