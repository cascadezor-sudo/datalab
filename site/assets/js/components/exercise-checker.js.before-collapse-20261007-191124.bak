/**
 * exercise-checker.js
 *
 * Для вопросов с data-tests: рендерит IDE-редактор с проверкой кода на сервере.
 * Поддерживает подсветку синтаксиса Python через «highlight backdrop»:
 * прозрачная textarea поверх div с цветными <span>, шрифт/отступы совпадают.
 *
 * ВАЖНО: не использует класс .code-block — inline-code-highlighter.js
 * перехватывает его через MutationObserver и стирает innerHTML.
 */
(function () {
  "use strict";

  // Перевод интерфейса (ядро — сниппет theme-boot). В тестах под Node его нет:
  // остаётся русский текст с подставленными значениями.
  const t =
    window.t ||
    ((text, params) =>
      text.replace(/\{(\w+)\}/g, (match, key) => params?.[key] ?? match));

  // В проде /api/* проксирует Caddy на контейнер code-runner, локально —
  // live-server из server.js на раннер, поднятый `npm run runner:dev`.
  const API_URL = "/api/run";

  // ── Утилиты ────────────────────────────────────────────────────────────────

  function esc(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  // ── Клавиатура редактора ───────────────────────────────────────────────────
  // Чистая функция: по тексту, выделению и клавише возвращает правку
  // {text, from, to, selStart, selEnd} или null, если клавишу трогать не надо.
  // Вынесена отдельно, чтобы её можно было проверить без DOM
  // (tests/exercise-editor-keys.test.js).

  const INDENT = "    ";

  function lineStartAt(value, index) {
    return value.lastIndexOf("\n", index - 1) + 1;
  }

  function lineEndAt(value, index) {
    const nl = value.indexOf("\n", index);
    return nl === -1 ? value.length : nl;
  }

  function applyKey(value, start, end, key, shift) {
    if (key === "Tab") {
      const multiline = value.slice(start, end).includes("\n");
      if (!shift && !multiline) {
        const caret = start + INDENT.length;
        return {
          text: INDENT,
          from: start,
          to: end,
          selStart: caret,
          selEnd: caret,
        };
      }
      // Отступ/снятие отступа у всех строк выделения. Если выделение
      // заканчивается сразу после перевода строки, следующую строку не трогаем.
      const from = lineStartAt(value, start);
      const lastAnchor = end > start && value[end - 1] === "\n" ? end - 1 : end;
      const to = lineEndAt(value, lastAnchor);
      let firstDelta = 0;
      let total = 0;
      const text = value
        .slice(from, to)
        .split("\n")
        .map((line, i) => {
          let delta;
          if (shift) {
            const spaces = Math.min(line.match(/^ */)[0].length, INDENT.length);
            delta = -spaces;
            line = line.slice(spaces);
          } else {
            delta = INDENT.length;
            line = INDENT + line;
          }
          if (i === 0) firstDelta = delta;
          total += delta;
          return line;
        })
        .join("\n");
      return {
        text,
        from,
        to,
        selStart: Math.max(from, start + firstDelta),
        selEnd: Math.max(from, end + total),
      };
    }

    if (key === "Enter") {
      const line = value.slice(lineStartAt(value, start), start);
      let indent = line.match(/^ */)[0];
      // Комментарий отрезаем грубо: `#` внутри строки перед `:` — редкость.
      if (line.replace(/#.*$/, "").trimEnd().endsWith(":")) indent += INDENT;
      const text = "\n" + indent;
      const caret = start + text.length;
      return { text, from: start, to: end, selStart: caret, selEnd: caret };
    }

    if (key === "Backspace" && start === end) {
      const before = value.slice(lineStartAt(value, start), start);
      if (
        before.length >= INDENT.length &&
        before.length % INDENT.length === 0 &&
        /^ +$/.test(before)
      ) {
        const from = start - INDENT.length;
        return { text: "", from, to: start, selStart: from, selEnd: from };
      }
    }

    return null;
  }

  // Правка через execCommand сохраняет историю Ctrl+Z; setRangeText — запасной путь.
  function replaceRange(textarea, edit) {
    textarea.setSelectionRange(edit.from, edit.to);
    let done = false;
    try {
      done = document.execCommand(
        edit.text ? "insertText" : "delete",
        false,
        edit.text,
      );
    } catch (_) {
      done = false;
    }
    const expected = textarea.value.slice(0, edit.from) + edit.text;
    if (!done || !textarea.value.startsWith(expected)) {
      textarea.setRangeText(edit.text, edit.from, edit.to, "end");
    }
    textarea.setSelectionRange(edit.selStart, edit.selEnd);
  }

  window.excEditorOps = { applyKey, draftStore };

  // Достаём текст из первого python-блока вопроса.
  // textContent работает даже на скрытых элементах (lazy-questions прячет .content).
  function getStarterCode(li) {
    const block = li.querySelector('[data-lang="python"],[data-lang="py"]');
    if (!block) return "";
    const codeText = block.querySelector(".code-text");
    return ((codeText || block).textContent || "").trim();
  }

  // ── Python syntax highlighter ──────────────────────────────────────────────

  const PY_KEYWORDS = new Set([
    "False",
    "None",
    "True",
    "and",
    "as",
    "assert",
    "async",
    "await",
    "break",
    "class",
    "continue",
    "def",
    "del",
    "elif",
    "else",
    "except",
    "finally",
    "for",
    "from",
    "global",
    "if",
    "import",
    "in",
    "is",
    "lambda",
    "nonlocal",
    "not",
    "or",
    "pass",
    "raise",
    "return",
    "try",
    "while",
    "with",
    "yield",
  ]);

  const PY_BUILTINS = new Set([
    "abs",
    "all",
    "any",
    "ascii",
    "bin",
    "bool",
    "breakpoint",
    "bytearray",
    "bytes",
    "callable",
    "chr",
    "classmethod",
    "compile",
    "complex",
    "delattr",
    "dict",
    "dir",
    "divmod",
    "enumerate",
    "eval",
    "exec",
    "filter",
    "float",
    "format",
    "frozenset",
    "getattr",
    "globals",
    "hasattr",
    "hash",
    "help",
    "hex",
    "id",
    "input",
    "int",
    "isinstance",
    "issubclass",
    "iter",
    "len",
    "list",
    "locals",
    "map",
    "max",
    "memoryview",
    "min",
    "next",
    "object",
    "oct",
    "open",
    "ord",
    "pow",
    "print",
    "property",
    "range",
    "repr",
    "reversed",
    "round",
    "set",
    "setattr",
    "slice",
    "sorted",
    "staticmethod",
    "str",
    "sum",
    "super",
    "tuple",
    "type",
    "vars",
    "zip",
  ]);

  const KW_RE = new RegExp("\\b(" + [...PY_KEYWORDS].join("|") + ")\\b", "g");
  const BUILTIN_RE = new RegExp(
    "\\b(" + [...PY_BUILTINS].join("|") + ")\\b",
    "g",
  );

  function highlightPython(code) {
    return code.split("\n").map(highlightLine).join("\n");
  }

  function hasTempFileSetup(tests) {
    return /\b(NamedTemporaryFile|TemporaryFile|mkstemp|TemporaryDirectory)\b/.test(
      tests,
    );
  }

  function findTopLevelComma(text) {
    let depth = 0;
    let inStr = false;
    let strCh = "";
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inStr) {
        if (c === strCh && text[i - 1] !== "\\") inStr = false;
        continue;
      }
      if (c === '"' || c === "'") {
        inStr = true;
        strCh = c;
      } else if ("([{".includes(c)) {
        depth++;
      } else if (")]}".includes(c)) {
        depth = Math.max(0, depth - 1);
      } else if (c === "," && depth === 0) {
        return i;
      }
    }
    return -1;
  }

  function findTopLevelOperator(text) {
    let depth = 0;
    let inStr = false;
    let strCh = "";
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inStr) {
        if (c === strCh && text[i - 1] !== "\\") inStr = false;
        continue;
      }
      if (c === '"' || c === "'") {
        inStr = true;
        strCh = c;
      } else if ("([{".includes(c)) {
        depth++;
      } else if (")]}".includes(c)) {
        depth = Math.max(0, depth - 1);
      } else if (depth === 0) {
        for (const op of ["==", "!=", ">=", "<=", ">", "<"]) {
          if (text.slice(i, i + op.length) === op) {
            return { index: i, op };
          }
        }
      }
    }
    return null;
  }

  function unwrapPythonString(text) {
    const trimmed = text.trim();
    const quote = trimmed[0];
    if ((quote !== '"' && quote !== "'") || trimmed.at(-1) !== quote) {
      return trimmed;
    }
    return trimmed
      .slice(1, -1)
      .replace(/\\n/g, "\n")
      .replace(/\\"/g, '"')
      .replace(/\\'/g, "'")
      .replace(/\\\\/g, "\\");
  }

  function parseAssertLine(line) {
    const trimmed = line.trim();
    if (!trimmed.startsWith("assert ")) return null;

    const commaIdx = findTopLevelComma(trimmed);
    const expr =
      commaIdx === -1
        ? trimmed.slice(7).trim()
        : trimmed.slice(7, commaIdx).trim();
    const message =
      commaIdx === -1 ? "" : unwrapPythonString(trimmed.slice(commaIdx + 1));
    const opInfo = findTopLevelOperator(expr);
    if (!opInfo) {
      return { message, condition: expr, expected: t("условие истинно") };
    }

    const left = expr.slice(0, opInfo.index).trim();
    const right = expr.slice(opInfo.index + opInfo.op.length).trim();
    const callMatch = left.match(/^([A-Za-z_]\w*)\(([\s\S]*)\)$/);

    return {
      message,
      condition: left,
      expected: `${opInfo.op} ${right}`,
      functionName: callMatch?.[1] || "",
      input: callMatch?.[2] || "",
    };
  }

  function buildReadableTests(tests) {
    const parsed = tests.split("\n").map(parseAssertLine).filter(Boolean);
    if (!parsed.length) return "";

    const items = parsed
      .map((test, idx) => {
        const title = test.message || t("Проверка {n}", { n: idx + 1 });
        const input = test.functionName
          ? `<div class="exc-visible-test-row">
              <span>${t("Вызов")}</span>
              <code>${esc(test.functionName)}(${esc(test.input)})</code>
            </div>`
          : `<div class="exc-visible-test-row">
              <span>${t("Условие")}</span>
              <code>${esc(test.condition)}</code>
            </div>`;

        return `<li class="exc-visible-test">
          <div class="exc-visible-test-badge">${idx + 1}</div>
          <div class="exc-visible-test-main">
            <div class="exc-visible-test-title">${esc(title)}</div>
            <div class="exc-visible-test-grid">
              ${input}
              <div class="exc-visible-test-row">
                <span>${t("Ожидаем")}</span>
                <code>${esc(test.expected)}</code>
              </div>
            </div>
          </div>
        </li>`;
      })
      .join("");

    return `<ol class="exc-visible-tests-list">${items}</ol>`;
  }

  function buildVisibleTests(tests) {
    const tempNote = hasTempFileSetup(tests)
      ? `<div class="exc-visible-tests-note">${t("Эти тесты сами создают временные файлы. Для локального дебага скопируй весь блок: в нём есть и содержимое файлов, и вызовы функций.")}</div>`
      : "";
    const readableTests = buildReadableTests(tests);

    return `
      <section class="exc-visible-tests" aria-label="${t("Проверочные тесты")}">
        <div class="exc-visible-tests-head">
          <div>
            <div class="exc-visible-tests-title">${t("Проверочные тесты")}</div>
            <div class="exc-visible-tests-subtitle">${t("Смысл проверок показан карточками, ниже — точный код автопроверки.")}</div>
          </div>
          <button type="button" class="exc-btn exc-btn--ghost exc-copy-tests">${t("Скопировать тесты")}</button>
        </div>
        ${tempNote}
        ${readableTests}
        <div class="exc-visible-tests-code-title">${t("Точный Python-код")}</div>
        <pre class="exc-visible-tests-code"><code>${highlightPython(tests)}</code></pre>
      </section>
    `;
  }

  function buildServerErrorHint(status) {
    if (!status || status < 500) return "";

    return `
      <div class="exc-server-hint">
        <b>${t("Это сбой сервера проверки, а не провал теста — твой код тут, скорее всего, ни при чём.")}</b>
        <ul>
          <li>${t("Подожди минуту и нажми «Проверить решение» ещё раз: сервер мог перезапускаться.")}</li>
          <li>${t("Если повторяется — скопируй код и текст ошибки выше и отправь через кнопку «В тексте ошибка?» под вопросом. Подробности уже записаны в консоль браузера (F12 → Console).")}</li>
        </ul>
      </div>
    `;
  }

  const HTTP_HINTS = {
    400: "Сервер не принял запрос",
    404: "Сервер проверки не найден по этому адресу",
    405: "По этому адресу нет сервера проверки",
    401: "Сессия истекла: обнови страницу и войди заново",
    403: "Нет доступа к проверке этого задания",
    413: "Код слишком длинный для отправки",
    422: "Сервер не понял формат запроса",
    429: "Подождите перед следующей попыткой",
    502: "Сервер проверки не запущен или перезапускается",
    503: "Сервер проверки временно недоступен",
    504: "Сервер проверки не ответил вовремя",
  };

  // Читает тело ответа с ошибкой: FastAPI кладёт текст в {detail}, но 502/504
  // от прокси приходят HTML-страницей, а 422 — списком объектов.
  async function readErrorDetail(resp) {
    const raw = await resp.text().catch(() => "");
    try {
      const json = JSON.parse(raw);
      const detail = json.detail ?? json.error ?? json.message;
      if (typeof detail === "string") return detail;
      if (detail != null) return JSON.stringify(detail);
    } catch (_) {
      /* не JSON */
    }
    if (/^\s*</.test(raw)) return "";
    return raw.trim().slice(0, 300);
  }

  // {short} — в строку статуса, {full} — в панель результатов.
  function describeFailure(err) {
    if (err.name === "TimeoutError" || err.name === "AbortError") {
      const short = t("Сервер проверки не ответил за 30 секунд");
      return { short, full: `${short}. ${t("Попробуй ещё раз.")}` };
    }
    if (err.status) {
      const hint = HTTP_HINTS[err.status]
        ? t(HTTP_HINTS[err.status])
        : t("Сервер проверки вернул ошибку");
      const short = `${hint} (HTTP ${err.status})`;
      return { short, full: err.detail ? `${short}: ${err.detail}` : short };
    }
    if (err instanceof TypeError) {
      return {
        short: t("Сервер проверки недоступен"),
        full: t(
          "Не удалось связаться с сервером проверки: нет сети, запрос заблокирован или сервер не запущен.",
        ),
      };
    }
    const message = err.message || String(err);
    return { short: message, full: message };
  }

  function highlightLine(line) {
    if (!line) return "";

    // Find comment start (skip chars inside strings)
    let commentIdx = -1;
    let inStr = false,
      strCh = "";
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (inStr) {
        if (c === strCh && line[i - 1] !== "\\") inStr = false;
      } else if (c === '"' || c === "'") {
        inStr = true;
        strCh = c;
      } else if (c === "#") {
        commentIdx = i;
        break;
      }
    }

    if (commentIdx !== -1) {
      return (
        highlightCode(line.slice(0, commentIdx)) +
        '<span class="exc-tok-comment">' +
        esc(line.slice(commentIdx)) +
        "</span>"
      );
    }
    return highlightCode(line);
  }

  function highlightCode(code) {
    if (!code) return "";

    // 1. Extract string literals as placeholders — must happen first so string
    //    contents are never inspected by keyword/builtin regexes.
    const strings = [];
    let text = code.replace(
      /(f?"""[\s\S]*?"""|f?'''[\s\S]*?'''|f?"[^"\n\\]*(?:\\.[^"\n\\]*)*"|f?'[^'\n\\]*(?:\\.[^'\n\\]*)*')/g,
      (m) => {
        strings.push(m);
        return "\x00s" + (strings.length - 1) + "\x00";
      },
    );

    // 2. Build a per-character type map from the RAW text (no HTML yet).
    //    All regex matching happens here — on plain text, never on HTML strings.
    //    First writer wins; later applyRe calls cannot overwrite already-claimed chars.
    const len = text.length;
    const typeArr = new Uint8Array(len); // 0 = plain text

    // Type codes → CSS class names
    const T_FN = 1,
      T_CLS = 2,
      T_DEC = 3,
      T_KW = 4,
      T_NUM = 5,
      T_BI = 6,
      T_SELF = 7;
    const CSS_CLASS = [
      "",
      "exc-tok-fn",
      "exc-tok-cls",
      "exc-tok-decorator",
      "exc-tok-kw",
      "exc-tok-num",
      "exc-tok-builtin",
      "exc-tok-self",
    ];

    function mark(start, end, type) {
      for (let i = start; i < end; i++) {
        if (!typeArr[i]) typeArr[i] = type;
      }
    }

    function applyRe(re, type) {
      let m;
      re.lastIndex = 0;
      while ((m = re.exec(text)) !== null) {
        mark(m.index, m.index + m[0].length, type);
      }
    }

    // Priority 1 — def/class names (override builtins, e.g. `class str`)
    let m;
    const DEF_RE = /\bdef\s+([a-zA-Z_]\w*)/g;
    while ((m = DEF_RE.exec(text)) !== null) {
      const ns = m.index + m[0].length - m[1].length;
      mark(ns, ns + m[1].length, T_FN);
    }
    const CLS_RE2 = /\bclass\s+([a-zA-Z_]\w*)/g;
    while ((m = CLS_RE2.exec(text)) !== null) {
      const ns = m.index + m[0].length - m[1].length;
      mark(ns, ns + m[1].length, T_CLS);
    }

    // Priority 2 — decorators (@property, @staticmethod, …)
    applyRe(/@\w+/g, T_DEC);

    // Priority 3 — keywords
    KW_RE.lastIndex = 0;
    applyRe(KW_RE, T_KW);

    // Priority 4 — numbers
    applyRe(/\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b/g, T_NUM);

    // Priority 5 — builtins
    BUILTIN_RE.lastIndex = 0;
    applyRe(BUILTIN_RE, T_BI);

    // Priority 6 — self / cls as parameters
    applyRe(/\b(self|cls)\b/g, T_SELF);

    // 3. Render HTML in a single left-to-right pass — HTML is only built here,
    //    so there is no risk of regex matching inside attribute values.
    let result = "";
    let i = 0;
    while (i < len) {
      const t = typeArr[i];
      if (!t) {
        let j = i + 1;
        while (j < len && !typeArr[j]) j++;
        result += esc(text.slice(i, j));
        i = j;
      } else {
        let j = i + 1;
        while (j < len && typeArr[j] === t) j++;
        result +=
          '<span class="' +
          CSS_CLASS[t] +
          '">' +
          esc(text.slice(i, j)) +
          "</span>";
        i = j;
      }
    }

    // 4. Restore string literals
    strings.forEach((str, idx) => {
      result = result
        .split("\x00s" + idx + "\x00")
        .join('<span class="exc-tok-str">' + esc(str) + "</span>");
    });

    return result;
  }

  // ── Firebase ───────────────────────────────────────────────────────────────

  function fbUser() {
    return (
      (typeof firebase !== "undefined" && firebase.auth().currentUser) || null
    );
  }

  function fbDb() {
    try {
      return typeof firebase !== "undefined" ? firebase.database() : null;
    } catch (_) {
      return null;
    }
  }

  async function fbToken() {
    const u = fbUser();
    if (window.__schmidtOfflineChecker && u) return "offline-local";
    return u && typeof u.getIdToken === "function" ? u.getIdToken(false) : null;
  }

  async function loadCode(qid) {
    const u = fbUser();
    if (!u) return null;
    const db = fbDb();
    if (!db) return null;
    try {
      const snap = await db
        .ref(`users/${u.uid}/exercises/${qid}/lastCode`)
        .once("value");
      return snap.val() || null;
    } catch (_) {
      return null;
    }
  }

  /** Резолвится в true, только когда код действительно лёг в базу. */
  function saveCode(qid, code) {
    const u = fbUser();
    const db = u && fbDb();
    if (!db) return Promise.resolve(false);
    return db
      .ref(`users/${u.uid}/exercises/${qid}/lastCode`)
      .set(code)
      .then(
        () => true,
        () => false,
      );
  }

  // ── Черновик ──────────────────────────────────────────────────────────────
  // saveCode пишет только после проверки на сервере, поэтому уход со страницы
  // до «Проверить» терял набранное. Черновик живёт в localStorage этого
  // браузера и снимается при отправке и сбросе.
  // ponytail: черновик локальный и побеждает lastCode из Firebase; правка на
  // другом устройстве без отправки сюда не доедет. Мешает — серверный черновик.
  // uid — геттер: раннер стартует по таймеру, раньше authGuard, и снятый один
  // раз uid оказался бы пустым — черновик писался бы под «anon» и терялся.
  function draftStore(storage, uid, qid) {
    const key = () => `exc-draft:${uid() || "anon"}:${qid}`;
    const safe = (fn) => {
      try {
        return fn();
      } catch (_) {
        return null;
      }
    };
    return {
      load: () => safe(() => storage().getItem(key())),
      save: (code) => safe(() => storage().setItem(key(), code)),
      clear: () => safe(() => storage().removeItem(key())),
    };
  }

  function saveAttempt(qid, passed, total, error) {
    const u = fbUser();
    if (!u) return;
    const db = fbDb();
    if (!db) return;
    db.ref(`users/${u.uid}/exercises/${qid}/attempts`)
      .push({
        ts: Date.now(),
        passed,
        total,
        ...(error ? { error: String(error).slice(0, 500) } : {}),
      })
      .catch(() => {});
  }

  function markDone(qid) {
    if (window.questionProgressTracker)
      window.questionProgressTracker.markQuestionCompleted(qid, true);
  }

  // ── Построение редактора ───────────────────────────────────────────────────

  function buildChecker(li, starterCode, tests, qid) {
    const root = document.createElement("div");
    root.className = "exc";

    root.innerHTML = `
      ${buildVisibleTests(tests)}
      <div class="exc-editor">
        <div class="exc-header">
          <span class="exc-lang">Python</span>
          <div class="exc-actions">
            <button type="button" class="exc-btn exc-btn--ghost exc-reset">${t("Сбросить")}</button>
            <button type="button" class="exc-btn exc-btn--primary exc-submit">${t("Проверить решение")}</button>
          </div>
        </div>
        <div class="exc-body">
          <div class="exc-lines" aria-hidden="true"></div>
          <div class="exc-code-wrap">
            <div class="exc-highlight" aria-hidden="true"></div>
            <textarea class="exc-textarea" spellcheck="false" autocorrect="off" autocomplete="off" autocapitalize="off"></textarea>
          </div>
        </div>
        <div class="exc-statusbar">
          <span class="exc-status" aria-live="polite"></span>
          <span class="exc-keys" aria-hidden="true"><kbd>Tab</kbd> ${t("отступ")} · <kbd>Shift</kbd>+<kbd>Tab</kbd> ${t("убрать")} · <kbd>Ctrl</kbd>+<kbd>Enter</kbd> ${t("проверить")} · <kbd>Esc</kbd> ${t("выйти из поля")}</span>
        </div>
      </div>
      <div class="exc-results" hidden></div>
    `;

    const textarea = root.querySelector(".exc-textarea");
    const highlightEl = root.querySelector(".exc-highlight");
    const linesEl = root.querySelector(".exc-lines");
    const submitBtn = root.querySelector(".exc-submit");
    const resetBtn = root.querySelector(".exc-reset");
    const copyTestsBtn = root.querySelector(".exc-copy-tests");
    const statusEl = root.querySelector(".exc-status");
    const resultsEl = root.querySelector(".exc-results");

    copyTestsBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(tests);
        copyTestsBtn.textContent = t("Скопировано");
        setTimeout(() => {
          copyTestsBtn.textContent = t("Скопировать тесты");
        }, 1600);
      } catch (_) {
        copyTestsBtn.textContent = t("Не удалось скопировать");
        setTimeout(() => {
          copyTestsBtn.textContent = t("Скопировать тесты");
        }, 1600);
      }
    });

    // ── Нумерация строк ───────────────────────────────────────────────────────

    function renderLines(n) {
      linesEl.textContent = "";
      for (let i = 1; i <= n; i++) {
        const d = document.createElement("div");
        d.textContent = i;
        linesEl.appendChild(d);
      }
    }

    // ── Подсветка синтаксиса ──────────────────────────────────────────────────

    function renderHighlight(code) {
      // Trailing newline: highlight div needs an extra empty line to match textarea height
      highlightEl.innerHTML = highlightPython(code) + "\n";
    }

    // ── Синхронизация скролла ──────────────────────────────────────────────────

    textarea.addEventListener("scroll", () => {
      linesEl.scrollTop = textarea.scrollTop;
      highlightEl.scrollTop = textarea.scrollTop;
      highlightEl.scrollLeft = textarea.scrollLeft;
    });

    // ── Установка кода ────────────────────────────────────────────────────────

    function refresh() {
      const code = textarea.value;
      renderLines(code.split("\n").length);
      renderHighlight(code);
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";
    }

    function setCode(code) {
      textarea.value = code;
      refresh();
    }

    // Обращение к localStorage в приватном окне может бросить — отсюда геттер.
    const draft = draftStore(
      () => localStorage,
      () => fbUser()?.uid,
      qid,
    );

    textarea.addEventListener("input", () => {
      refresh();
      draft.save(textarea.value);
    });

    // Esc отпускает Tab на один раз, чтобы с клавиатуры можно было уйти из поля.
    let passTab = false;
    textarea.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        passTab = true;
        return;
      }
      if (e.key === "Tab" && passTab) {
        passTab = false;
        return;
      }
      // Нажатие самого Shift перед Shift+Tab не должно сбрасывать разрешение.
      if (!["Shift", "Control", "Alt", "Meta"].includes(e.key)) passTab = false;

      if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        if (!submitBtn.disabled) runCheck();
        return;
      }
      if (e.altKey || e.ctrlKey || e.metaKey) return;

      const edit = applyKey(
        textarea.value,
        textarea.selectionStart,
        textarea.selectionEnd,
        e.key,
        e.shiftKey,
      );
      if (!edit) return;
      e.preventDefault();
      replaceRange(textarea, edit);
      refresh();
      draft.save(textarea.value);
    });

    // ── Кнопки ───────────────────────────────────────────────────────────────

    resetBtn.addEventListener("click", () => {
      draft.clear();
      setCode(starterCode);
      resultsEl.hidden = true;
      statusEl.textContent = "";
      statusEl.className = "exc-status";
    });

    submitBtn.addEventListener("click", runCheck);

    // ── Загрузка сохранённого кода ────────────────────────────────────────────

    // Ждём authGuard: без пользователя не найти ни черновик, ни lastCode.
    Promise.resolve(window.authReady)
      .catch(() => {})
      .then(() => draft.load() || loadCode(qid))
      .then((saved) => setCode(saved || starterCode));

    // ── Проверка ──────────────────────────────────────────────────────────────

    async function runCheck() {
      const code = textarea.value.trim();
      if (!code) return;

      submitBtn.disabled = true;
      statusEl.textContent = t("Выполняется…");
      statusEl.className = "exc-status";
      resultsEl.hidden = true;

      const token = await fbToken().catch(() => null);
      if (!token) {
        statusEl.textContent = t("Необходима авторизация");
        statusEl.className = "exc-status exc-status--err";
        submitBtn.disabled = false;
        return;
      }

      let data;
      try {
        const resp = await fetch(API_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
            ...(window.__schmidtOfflineChecker ? { "X-SchmidtML-Local": "1" } : {}),
          },
          body: JSON.stringify({
            code: textarea.value,
            tests,
            question_id: qid,
          }),
          // Старые Safari/Chrome без AbortSignal.timeout просто ждут без лимита.
          signal: AbortSignal.timeout ? AbortSignal.timeout(30000) : undefined,
        });
        if (!resp.ok) {
          const detail = await readErrorDetail(resp);
          throw Object.assign(new Error(`HTTP ${resp.status}`), {
            status: resp.status,
            detail,
          });
        }
        data = await resp.json();
      } catch (err) {
        const { short, full } = describeFailure(err);
        console.error("[exercise-checker] Проверка не выполнена", {
          question: qid,
          status: err.status || null,
          detail: err.detail || err.message,
          error: err,
        });
        statusEl.textContent = "✗ " + short;
        statusEl.className = "exc-status exc-status--err";
        submitBtn.disabled = false;
        if (err.status === 429) return;
        resultsEl.innerHTML = `
          <div class="exc-runtime-err"><b>${t("Не удалось выполнить проверку")}</b><pre>${esc(full)}</pre></div>
          ${buildServerErrorHint(err.status)}
        `;
        resultsEl.hidden = false;
        return;
      }

      const passed = (data.tests || []).filter((t) => t.passed).length;
      const total = (data.tests || []).length;
      // Черновик снимаем, только когда код доехал до базы: иначе он —
      // единственная копия.
      const sent = textarea.value;
      saveCode(qid, sent).then((ok) => {
        if (ok && textarea.value === sent) draft.clear();
      });
      saveAttempt(qid, passed, total, data.error || null);
      renderResults(data, passed, total);
      submitBtn.disabled = false;
    }

    // ── Рендер результатов ────────────────────────────────────────────────────

    function renderResults(data, passed, total) {
      const parts = [];

      if (data.error) {
        parts.push(
          `<div class="exc-runtime-err"><b>${t("Ошибка выполнения:")}</b><pre>${esc(data.error)}</pre></div>`,
        );
      }

      if (data.stdout && data.stdout.trim()) {
        parts.push(
          `<div class="exc-stdout"><span class="exc-stdout-label">${t("Вывод")}</span><pre>${esc(data.stdout.trim())}</pre></div>`,
        );
      }

      if (data.tests && data.tests.length) {
        const allOk = passed === total;
        parts.push(
          allOk
            ? `<div class="exc-summary exc-summary--ok">✓ ${t("Все тесты пройдены ({passed}/{total})", { passed, total })}</div>`
            : `<div class="exc-summary exc-summary--fail">✗ ${t("Пройдено {passed} из {total}", { passed, total })}</div>`,
        );

        parts.push('<div class="exc-tests">');
        for (const res of data.tests) {
          const ok = res.passed;
          const hasDetails = !ok && (res.input || res.actual || res.expected);
          const detailsHtml = hasDetails
            ? `<div class="exc-test-details">
                ${res.input ? `<div class="exc-test-detail"><span>${t("Что подалось на вход")}</span><pre>${esc(res.input)}</pre></div>` : ""}
                ${res.actual ? `<div class="exc-test-detail"><span>${t("Что выдал код")}</span><pre>${esc(res.actual)}</pre></div>` : ""}
                ${res.expected ? `<div class="exc-test-detail"><span>${t("Ожидаемый ответ")}</span><pre>${esc(res.expected)}</pre></div>` : ""}
              </div>`
            : "";
          const errHtml =
            !ok && !hasDetails && res.error && res.error !== res.label
              ? `<div class="exc-test-err">${esc(res.error)}</div>`
              : "";
          parts.push(`<div class="exc-test ${ok ? "exc-test--ok" : "exc-test--fail"}">
            <div class="exc-test-head">
              <span class="exc-test-icon">${ok ? "✓" : "✗"}</span>
              <span>${esc(res.label)}</span>
            </div>
            ${detailsHtml}
            ${errHtml}
          </div>`);
        }
        parts.push("</div>");

        if (passed === total) {
          statusEl.textContent = `✓ ${t("Все тесты пройдены")}`;
          statusEl.className = "exc-status exc-status--ok";
          markDone(qid);
        } else {
          statusEl.textContent = `✗ ${passed}/${total}`;
          statusEl.className = "exc-status exc-status--fail";
        }
      } else if (!data.error) {
        statusEl.textContent = "";
      } else {
        statusEl.textContent = `✗ ${t("Ошибка")}`;
        statusEl.className = "exc-status exc-status--err";
      }

      if (data.lint && data.lint.length) {
        const rows = data.lint
          .map(
            (l) =>
              `<div class="exc-lint-row"><code class="exc-lint-code">${esc(l.code)}</code> ${t("стр. {row}", { row: l.row })}: ${esc(l.message)}</div>`,
          )
          .join("");
        parts.push(`<details class="exc-lint">
          <summary>${t("Замечания линтера ({count})", { count: data.lint.length })}</summary>
          ${rows}
          <div class="exc-lint-tip">${t("Установи ruff локально:")} <code>pip install ruff && ruff check .</code></div>
        </details>`);
      }

      resultsEl.innerHTML = parts.join("");
      resultsEl.hidden = false;
      resultsEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    return root;
  }

  // ── Инициализация ─────────────────────────────────────────────────────────

  function initQuestion(li) {
    if (li.dataset.excInit) return;

    const tests = li.dataset.tests;
    if (!tests) return;
    if (isManualDeliveryQuestion(li)) return;

    const qid = li.dataset.mdId || li.id || "";
    const starterCode = getStarterCode(li);
    if (!starterCode) return;

    li.dataset.excInit = "1";

    // Скрываем исходный code-block (textarea его заменяет)
    const src = li.querySelector('[data-lang="python"],[data-lang="py"]');
    if (src) src.style.display = "none";

    const checker = buildChecker(li, starterCode, tests, qid);
    (li.querySelector(".content") || li).appendChild(checker);
  }

  function initAll() {
    document.querySelectorAll("li.question[data-tests]").forEach(initQuestion);
  }

  function isManualDeliveryQuestion(li) {
    const delivery = String(li?.dataset?.delivery || "")
      .trim()
      .toLowerCase();
    return ["ide", "local", "offline", "external"].includes(delivery);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () =>
      setTimeout(initAll, 500),
    );
  } else {
    setTimeout(initAll, 500);
  }

  function startObserver() {
    new MutationObserver(() => setTimeout(initAll, 300)).observe(
      document.body,
      { childList: true, subtree: true },
    );
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startObserver);
  } else {
    startObserver();
  }
})();
